# Environment: development | production
EXPENSEAI_ENV=development

# Database Configuration
EXPENSEAI_DATABASE_URL=sqlite:///./backend/expenseai.db

# Security
EXPENSEAI_SECRET_KEY=yours-super-secret-key-change-this-in-prod
EXPENSEAI_ALGORITHM=HS256
EXPENSEAI_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (Comma-separated list of origins)
EXPENSEAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: Port
PORT=8000
